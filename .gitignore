# ──────────────────────────────────────────────
# 3-Eyed Raven — Next.js .gitignore
# ──────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Next.js Build Output ──────────────────────
.next/
out/
build/
dist/

# ── Database (SQLite — never commit live data) ─
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Environment Variables ─────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Logs ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ── OS & Editor Junk ──────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.orig

# ── TypeScript ────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────
.vercel
.cache
*.pem
